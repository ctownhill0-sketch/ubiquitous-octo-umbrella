{
  "name": "leadstack",
  "version": "1.0.0",
  "description": "LeadStack - Premium Lead Generation Desktop App",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build-react": "cd frontend && npm run build",
    "dev": "concurrently \"cd frontend && npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "dist": "npm run build-react && electron-builder --mac",
    "dist:dmg": "npm run build-react && electron-builder --mac dmg"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.leadstack.app",
    "productName": "LeadStack",
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png",
      "darkModeSupport": true
    },
    "dmg": {
      "title": "LeadStack",
      "background": "electron/dmg-background.png",
      "icon": "electron/icon.png",
      "iconSize": 80,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "backend/**/*",
      "!backend/__pycache__",
      "!backend/*.pyc",
      "!backend/leads.db",
      "!backend/server_v1.py",
      "!backend/debug_*.py",
      "!backend/app.py",
      "!backend/run.sh",
      "!backend/run.bat",
      "!backend/money_machine.db"
    ]
  },
  "author": "LeadStack"
}