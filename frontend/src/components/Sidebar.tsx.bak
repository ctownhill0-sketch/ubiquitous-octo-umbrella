// LeadStack™ Sidebar — Bloomberg Terminal meets Stripe aesthetic
import { motion, AnimatePresence } from "framer-motion";
import {
  LayoutDashboard, Search, Mail, GitBranch, MessageSquare,
  BarChart3, Settings, Bell, ChevronLeft, ChevronRight,
  Zap, LogOut
} from "lucide-react";
import { useState } from "react";
import { cn } from "@/lib/utils";

export type SectionId = "dashboard" | "scraper" | "email" | "followup" | "replies" | "report" | "settings";

interface SidebarProps {
  active: SectionId;
  onChange: (id: SectionId) => void;
  notifications?: number;
}

const NAV_ITEMS: { id: SectionId; label: string; icon: React.ElementType; badge?: string }[] = [
  { id: "dashboard", label: "Dashboard", icon: LayoutDashboard },
  { id: "scraper", label: "Scraper Engine", icon: Search },
  { id: "email", label: "Email Engine", icon: Mail },
  { id: "followup", label: "Follow-Up", icon: GitBranch },
  { id: "replies", label: "Reply Monitor", icon: MessageSquare, badge: "2" },
  { id: "report", label: "Daily Report", icon: BarChart3 },
  { id: "settings", label: "Settings", icon: Settings },
];

export default function Sidebar({ active, onChange, notifications = 2 }: SidebarProps) {
  const [collapsed, setCollapsed] = useState(false);

  return (
    <motion.aside
      animate={{ width: collapsed ? 64 : 220 }}
      transition={{ duration: 0.2, ease: "easeInOut" }}
      className="flex flex-col h-screen relative z-20 overflow-hidden"
      style={{
        background: "oklch(0.11 0.025 255)",
        borderRight: "1px solid oklch(1 0 0 / 0.06)",
        flexShrink: 0,
      }}
    >
      {/* Logo */}
      <div className="flex items-center gap-3 px-4 py-5 overflow-hidden"
        style={{ borderBottom: "1px solid oklch(1 0 0 / 0.06)" }}>
        <div className="flex-shrink-0 w-8 h-8 rounded flex items-center justify-center"
          style={{ background: "oklch(0.72 0.12 75 / 0.15)", border: "1px solid oklch(0.72 0.12 75 / 0.3)" }}>
          <Zap size={16} style={{ color: "oklch(0.72 0.12 75)" }} />
        </div>
        <AnimatePresence>
          {!collapsed && (
            <motion.div
              initial={{ opacity: 0, x: -10 }}
              animate={{ opacity: 1, x: 0 }}
              exit={{ opacity: 0, x: -10 }}
              transition={{ duration: 0.15 }}
              className="overflow-hidden whitespace-nowrap"
            >
              <div className="text-sm font-bold tracking-tight" style={{ color: "oklch(0.92 0.008 65)" }}>
                LeadStack<span style={{ color: "oklch(0.72 0.12 75)" }}>™</span>
              </div>
              <div className="text-[10px] font-medium tracking-widest uppercase"
                style={{ color: "oklch(0.55 0.015 255)" }}>
                Lead Platform
              </div>
            </motion.div>
          )}
        </AnimatePresence>
      </div>

      {/* Machine Status */}
      <AnimatePresence>
        {!collapsed && (
          <motion.div
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0 }}
            className="mx-3 mt-3 mb-1 px-3 py-2 rounded"
            style={{ background: "oklch(0.65 0.18 145 / 0.08)", border: "1px solid oklch(0.65 0.18 145 / 0.2)" }}
          >
            <div className="flex items-center gap-2">
              <div className="pulse-dot flex-shrink-0" />
              <span className="text-xs font-medium" style={{ color: "oklch(0.72 0.16 145)" }}>
                Machine Running
              </span>
            </div>
          </motion.div>
        )}
      </AnimatePresence>

      {/* Nav Items */}
      <nav className="flex-1 px-2 py-3 space-y-0.5 overflow-y-auto overflow-x-hidden">
        {NAV_ITEMS.map((item) => {
          const Icon = item.icon;
          const isActive = active === item.id;
          return (
            <button
              key={item.id}
              onClick={() => onChange(item.id)}
              className={cn(
                "w-full flex items-center gap-3 px-3 py-2.5 rounded-md text-sm font-medium transition-all duration-150 relative overflow-hidden",
                isActive
                  ? "text-[oklch(0.72_0.12_75)]"
                  : "text-[oklch(0.55_0.015_255)] hover:text-[oklch(0.85_0.008_65)]"
              )}
              style={isActive ? {
                background: "oklch(0.72 0.12 75 / 0.10)",
                borderLeft: "2px solid oklch(0.72 0.12 75)",
                paddingLeft: "calc(0.75rem - 2px)",
              } : {
                paddingLeft: "0.75rem",
              }}
            >
              <Icon size={16} className="flex-shrink-0" />
              <AnimatePresence>
                {!collapsed && (
                  <motion.span
                    initial={{ opacity: 0, x: -8 }}
                    animate={{ opacity: 1, x: 0 }}
                    exit={{ opacity: 0, x: -8 }}
                    transition={{ duration: 0.12 }}
                    className="whitespace-nowrap flex-1 text-left"
                  >
                    {item.label}
                  </motion.span>
                )}
              </AnimatePresence>
              {!collapsed && item.badge && (
                <span className="text-[10px] font-bold px-1.5 py-0.5 rounded-full"
                  style={{ background: "oklch(0.65 0.22 25 / 0.2)", color: "oklch(0.75 0.20 25)" }}>
                  {item.badge}
                </span>
              )}
            </button>
          );
        })}
      </nav>

      {/* Bottom */}
      <div className="px-2 py-3 space-y-0.5" style={{ borderTop: "1px solid oklch(1 0 0 / 0.06)" }}>
        <button
          className="w-full flex items-center gap-3 px-3 py-2.5 rounded-md text-sm font-medium transition-all duration-150"
          style={{ color: "oklch(0.55 0.015 255)" }}
        >
          <LogOut size={16} className="flex-shrink-0" />
          <AnimatePresence>
            {!collapsed && (
              <motion.span
                initial={{ opacity: 0 }}
                animate={{ opacity: 1 }}
                exit={{ opacity: 0 }}
                className="whitespace-nowrap"
              >
                Sign Out
              </motion.span>
            )}
          </AnimatePresence>
        </button>
      </div>

      {/* Collapse Toggle */}
      <button
        onClick={() => setCollapsed(!collapsed)}
        className="absolute -right-3 top-[72px] w-6 h-6 rounded-full flex items-center justify-center z-30 transition-colors"
        style={{
          background: "oklch(0.16 0.025 255)",
          border: "1px solid oklch(1 0 0 / 0.12)",
          color: "oklch(0.55 0.015 255)",
        }}
      >
        {collapsed ? <ChevronRight size={12} /> : <ChevronLeft size={12} />}
      </button>
    </motion.aside>
  );
}
