// LeadStack™ — Scraper Engine Section
import { motion } from "framer-motion";
import { useState } from "react";
import { BarChart, Bar, XAxis, YAxis, Tooltip, ResponsiveContainer, CartesianGrid } from "recharts";
import { Play, Square, Plus, MapPin, CheckCircle, Clock, AlertCircle, Loader2, Trash2 } from "lucide-react";
import { MOCK_SCRAPER_JOBS, CITY_PERFORMANCE } from "@/lib/mockData";
import { toast } from "sonner";

const SOURCE_DATA = [
  { name: "Google Maps", value: 312, color: "oklch(0.72 0.12 75)" },
  { name: "FINRA", value: 67, color: "oklch(0.55 0.10 230)" },
  { name: "LinkedIn", value: 33, color: "oklch(0.65 0.18 145)" },
];

const CustomTooltip = ({ active, payload, label }: any) => {
  if (!active || !payload?.length) return null;
  return (
    <div className="rounded-lg px-3 py-2 text-xs" style={{ background: "oklch(0.16 0.025 255)", border: "1px solid oklch(1 0 0 / 0.12)" }}>
      <p className="font-semibold mb-1" style={{ color: "oklch(0.92 0.008 65)" }}>{label}</p>
      {payload.map((p: any) => (
        <p key={p.name} style={{ color: p.color }}>{p.name}: {p.value}</p>
      ))}
    </div>
  );
};

export default function ScraperSection() {
  const [jobs, setJobs] = useState(MOCK_SCRAPER_JOBS);
  const [keyword, setKeyword] = useState("independent financial advisor");
  const [city, setCity] = useState("");
  const [maxResults, setMaxResults] = useState("20");
  const [running, setRunning] = useState(false);

  const statusIcon = (status: string) => {
    if (status === "completed") return <CheckCircle size={13} style={{ color: "oklch(0.65 0.18 145)" }} />;
    if (status === "running") return <Loader2 size={13} className="animate-spin" style={{ color: "oklch(0.72 0.12 75)" }} />;
    if (status === "failed") return <AlertCircle size={13} style={{ color: "oklch(0.65 0.22 25)" }} />;
    return <Clock size={13} style={{ color: "oklch(0.55 0.015 255)" }} />;
  };

  const statusColor = (status: string) => {
    if (status === "completed") return "oklch(0.65 0.18 145)";
    if (status === "running") return "oklch(0.72 0.12 75)";
    if (status === "failed") return "oklch(0.65 0.22 25)";
    return "oklch(0.55 0.015 255)";
  };

  const handleAddJob = () => {
    if (!city.trim()) { toast.error("Please enter a city"); return; }
    const newJob = {
      id: Date.now(), keyword, city: city.split(",")[0].trim(),
      state: city.split(",")[1]?.trim() || "",
      status: "pending" as const, leadsFound: 0,
      startedAt: "", completedAt: null,
    };
    setJobs(prev => [...prev, newJob]);
    setCity("");
    toast.success(`Added ${newJob.city} to queue`);
  };

  const handleStart = () => {
    setRunning(true);
    toast.success("Scraper engine started", { description: "Processing city queue..." });
    setTimeout(() => setRunning(false), 3000);
  };

  const totalLeads = jobs.reduce((s, j) => s + j.leadsFound, 0);
  const completed = jobs.filter(j => j.status === "completed").length;

  return (
    <div className="p-6 space-y-6">
      {/* Top Stats */}
      <div className="grid grid-cols-2 lg:grid-cols-4 gap-4">
        {[
          { label: "Cities Queued", value: jobs.length, color: "oklch(0.72 0.12 75)" },
          { label: "Completed", value: completed, color: "oklch(0.65 0.18 145)" },
          { label: "Leads Found Today", value: totalLeads, color: "oklch(0.72 0.12 75)" },
          { label: "Avg per City", value: completed > 0 ? Math.round(totalLeads / completed) : 0, color: "oklch(0.55 0.10 230)" },
        ].map((s, i) => (
          <motion.div key={s.label}
            initial={{ opacity: 0, y: 16 }} animate={{ opacity: 1, y: 0 }}
            transition={{ delay: i * 0.07 }}
            className="rounded-lg p-4"
            style={{ background: "oklch(0.13 0.025 255)", border: "1px solid oklch(1 0 0 / 0.07)", borderTop: `2px solid ${s.color}` }}>
            <div className="stat-number text-2xl font-bold mb-1" style={{ color: "oklch(0.92 0.008 65)" }}>{s.value}</div>
            <div className="text-xs" style={{ color: "oklch(0.55 0.015 255)" }}>{s.label}</div>
          </motion.div>
        ))}
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-4">
        {/* Controls */}
        <motion.div initial={{ opacity: 0, y: 16 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.3 }}
          className="rounded-lg p-4 space-y-4"
          style={{ background: "oklch(0.13 0.025 255)", border: "1px solid oklch(1 0 0 / 0.07)" }}>
          <h3 className="text-sm font-semibold" style={{ color: "oklch(0.92 0.008 65)" }}>Search Controls</h3>

          <div className="space-y-3">
            <div>
              <label className="text-[10px] font-medium block mb-1.5" style={{ color: "oklch(0.55 0.015 255)" }}>KEYWORD</label>
              <input value={keyword} onChange={e => setKeyword(e.target.value)}
                className="w-full px-3 py-2 rounded text-xs input-gold transition-all"
                style={{ background: "oklch(1 0 0 / 0.04)", border: "1px solid oklch(1 0 0 / 0.10)", color: "oklch(0.92 0.008 65)" }} />
            </div>
            <div>
              <label className="text-[10px] font-medium block mb-1.5" style={{ color: "oklch(0.55 0.015 255)" }}>CITY, STATE</label>
              <div className="flex gap-2">
                <input value={city} onChange={e => setCity(e.target.value)}
                  placeholder="e.g. Austin, TX"
                  onKeyDown={e => e.key === "Enter" && handleAddJob()}
                  className="flex-1 px-3 py-2 rounded text-xs input-gold transition-all"
                  style={{ background: "oklch(1 0 0 / 0.04)", border: "1px solid oklch(1 0 0 / 0.10)", color: "oklch(0.92 0.008 65)" }} />
                <button onClick={handleAddJob}
                  className="px-3 py-2 rounded text-xs font-medium transition-colors flex items-center gap-1.5"
                  style={{ background: "oklch(0.72 0.12 75 / 0.15)", color: "oklch(0.72 0.12 75)", border: "1px solid oklch(0.72 0.12 75 / 0.3)" }}>
                  <Plus size={12} /> Add
                </button>
              </div>
            </div>
            <div>
              <label className="text-[10px] font-medium block mb-1.5" style={{ color: "oklch(0.55 0.015 255)" }}>MAX RESULTS PER CITY</label>
              <input value={maxResults} onChange={e => setMaxResults(e.target.value)} type="number"
                className="w-full px-3 py-2 rounded text-xs input-gold transition-all"
                style={{ background: "oklch(1 0 0 / 0.04)", border: "1px solid oklch(1 0 0 / 0.10)", color: "oklch(0.92 0.008 65)" }} />
            </div>
          </div>

          <div className="flex gap-2 pt-1">
            <button onClick={handleStart} disabled={running}
              className="flex-1 flex items-center justify-center gap-2 py-2.5 rounded text-xs font-semibold transition-all"
              style={{ background: running ? "oklch(0.72 0.12 75 / 0.3)" : "oklch(0.72 0.12 75)", color: "oklch(0.10 0.025 255)" }}>
              {running ? <Loader2 size={13} className="animate-spin" /> : <Play size={13} />}
              {running ? "Running..." : "Start Scraper"}
            </button>
            <button
              className="px-3 py-2.5 rounded text-xs font-medium transition-colors"
              style={{ background: "oklch(0.65 0.22 25 / 0.12)", color: "oklch(0.75 0.20 25)", border: "1px solid oklch(0.65 0.22 25 / 0.25)" }}>
              <Square size={13} />
            </button>
          </div>

          {/* Source Breakdown */}
          <div className="pt-2 section-divider">
            <p className="text-[10px] font-medium mb-3" style={{ color: "oklch(0.55 0.015 255)" }}>SOURCE BREAKDOWN</p>
            <div className="space-y-2">
              {SOURCE_DATA.map(s => {
                const total = SOURCE_DATA.reduce((a, b) => a + b.value, 0);
                const pct = Math.round((s.value / total) * 100);
                return (
                  <div key={s.name}>
                    <div className="flex justify-between text-[10px] mb-1">
                      <span style={{ color: "oklch(0.75 0.008 65)" }}>{s.name}</span>
                      <span className="font-mono font-semibold" style={{ color: s.color }}>{pct}%</span>
                    </div>
                    <div className="h-1 rounded-full" style={{ background: "oklch(1 0 0 / 0.06)" }}>
                      <motion.div initial={{ width: 0 }} animate={{ width: `${pct}%` }}
                        transition={{ duration: 0.8, delay: 0.5 }}
                        className="h-full rounded-full" style={{ background: s.color }} />
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </motion.div>

        {/* Job Queue */}
        <motion.div initial={{ opacity: 0, y: 16 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.4 }}
          className="lg:col-span-2 rounded-lg p-4"
          style={{ background: "oklch(0.13 0.025 255)", border: "1px solid oklch(1 0 0 / 0.07)" }}>
          <div className="flex items-center justify-between mb-4">
            <h3 className="text-sm font-semibold" style={{ color: "oklch(0.92 0.008 65)" }}>City Queue</h3>
            <span className="text-[10px] font-mono" style={{ color: "oklch(0.55 0.015 255)" }}>{jobs.length} cities</span>
          </div>

          <div className="space-y-2 max-h-[320px] overflow-y-auto pr-1">
            {jobs.map((job, i) => (
              <motion.div key={job.id}
                initial={{ opacity: 0, x: -10 }} animate={{ opacity: 1, x: 0 }}
                transition={{ delay: 0.5 + i * 0.04 }}
                className="flex items-center gap-3 p-3 rounded-lg"
                style={{ background: "oklch(1 0 0 / 0.02)", border: "1px solid oklch(1 0 0 / 0.05)" }}>
                <div className="flex-shrink-0">{statusIcon(job.status)}</div>
                <div className="flex-shrink-0 w-6 h-6 rounded flex items-center justify-center"
                  style={{ background: "oklch(0.72 0.12 75 / 0.10)" }}>
                  <MapPin size={11} style={{ color: "oklch(0.72 0.12 75)" }} />
                </div>
                <div className="flex-1 min-w-0">
                  <div className="text-xs font-medium" style={{ color: "oklch(0.85 0.008 65)" }}>
                    {job.city}{job.state ? `, ${job.state}` : ""}
                  </div>
                  <div className="text-[10px]" style={{ color: "oklch(0.45 0.015 255)" }}>{job.keyword}</div>
                </div>
                <div className="text-right flex-shrink-0">
                  {job.leadsFound > 0 && (
                    <div className="font-mono text-xs font-semibold" style={{ color: "oklch(0.72 0.12 75)" }}>
                      {job.leadsFound} leads
                    </div>
                  )}
                  <div className="text-[10px] capitalize" style={{ color: statusColor(job.status) }}>
                    {job.status}
                  </div>
                </div>
                <button onClick={() => setJobs(prev => prev.filter(j => j.id !== job.id))}
                  className="flex-shrink-0 w-6 h-6 rounded flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity"
                  style={{ color: "oklch(0.55 0.015 255)" }}>
                  <Trash2 size={11} />
                </button>
              </motion.div>
            ))}
          </div>

          {/* City Bar Chart */}
          <div className="mt-4 pt-4 section-divider">
            <p className="text-[10px] font-medium mb-3" style={{ color: "oklch(0.55 0.015 255)" }}>LEADS PER CITY</p>
            <ResponsiveContainer width="100%" height={100}>
              <BarChart data={CITY_PERFORMANCE} margin={{ top: 0, right: 0, bottom: 0, left: -30 }}>
                <CartesianGrid strokeDasharray="3 3" stroke="oklch(1 0 0 / 0.04)" />
                <XAxis dataKey="city" tick={{ fontSize: 9, fill: "oklch(0.45 0.015 255)" }}
                  tickFormatter={v => v.split(",")[0]} axisLine={false} tickLine={false} />
                <YAxis tick={{ fontSize: 9, fill: "oklch(0.45 0.015 255)" }} axisLine={false} tickLine={false} />
                <Tooltip content={<CustomTooltip />} />
                <Bar dataKey="leads" name="Leads" fill="oklch(0.72 0.12 75)" radius={[3, 3, 0, 0]} />
              </BarChart>
            </ResponsiveContainer>
          </div>
        </motion.div>
      </div>
    </div>
  );
}
