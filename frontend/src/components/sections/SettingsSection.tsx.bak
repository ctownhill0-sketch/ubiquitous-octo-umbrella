// LeadStack™ — Settings Section
import { useState } from "react";
import { motion } from "framer-motion";
import { Key, Mail, MapPin, Clock, Bell, Shield, Save, Eye, EyeOff, CheckCircle } from "lucide-react";
import { toast } from "sonner";

const SettingCard = ({ title, icon: Icon, children }: { title: string; icon: React.ElementType; children: React.ReactNode }) => (
  <motion.div
    initial={{ opacity: 0, y: 16 }}
    animate={{ opacity: 1, y: 0 }}
    className="rounded-xl p-5"
    style={{ background: "oklch(0.13 0.025 255)", border: "1px solid oklch(1 0 0 / 0.07)" }}
  >
    <div className="flex items-center gap-2 mb-4">
      <div className="w-7 h-7 rounded-lg flex items-center justify-center" style={{ background: "oklch(0.72 0.12 75 / 0.12)" }}>
        <Icon size={14} style={{ color: "oklch(0.72 0.12 75)" }} />
      </div>
      <h3 className="text-sm font-semibold" style={{ color: "oklch(0.92 0.008 65)" }}>{title}</h3>
    </div>
    {children}
  </motion.div>
);

const Field = ({ label, value, type = "text", placeholder, onChange, hint }: {
  label: string; value: string; type?: string; placeholder?: string;
  onChange: (v: string) => void; hint?: string;
}) => {
  const [show, setShow] = useState(false);
  const isSecret = type === "password";
  return (
    <div className="mb-4">
      <label className="block text-xs font-medium mb-1.5" style={{ color: "oklch(0.65 0.008 65)" }}>{label}</label>
      <div className="relative">
        <input
          type={isSecret && !show ? "password" : "text"}
          value={value}
          onChange={e => onChange(e.target.value)}
          placeholder={placeholder}
          className="w-full rounded-lg px-3 py-2 text-sm outline-none transition-all"
          style={{
            background: "oklch(0.10 0.02 255)",
            border: "1px solid oklch(1 0 0 / 0.08)",
            color: "oklch(0.85 0.008 65)",
          }}
          onFocus={e => e.target.style.borderColor = "oklch(0.72 0.12 75 / 0.5)"}
          onBlur={e => e.target.style.borderColor = "oklch(1 0 0 / 0.08)"}
        />
        {isSecret && (
          <button onClick={() => setShow(!show)} className="absolute right-3 top-1/2 -translate-y-1/2"
            style={{ color: "oklch(0.45 0.015 255)" }}>
            {show ? <EyeOff size={13} /> : <Eye size={13} />}
          </button>
        )}
      </div>
      {hint && <p className="text-[10px] mt-1" style={{ color: "oklch(0.45 0.015 255)" }}>{hint}</p>}
    </div>
  );
};

const Toggle = ({ label, description, checked, onChange }: {
  label: string; description: string; checked: boolean; onChange: (v: boolean) => void;
}) => (
  <div className="flex items-center justify-between py-3" style={{ borderBottom: "1px solid oklch(1 0 0 / 0.05)" }}>
    <div>
      <div className="text-sm" style={{ color: "oklch(0.85 0.008 65)" }}>{label}</div>
      <div className="text-[10px] mt-0.5" style={{ color: "oklch(0.45 0.015 255)" }}>{description}</div>
    </div>
    <button
      onClick={() => onChange(!checked)}
      className="relative w-10 h-5 rounded-full transition-all flex-shrink-0"
      style={{ background: checked ? "oklch(0.72 0.12 75)" : "oklch(1 0 0 / 0.1)" }}
    >
      <motion.div
        animate={{ x: checked ? 22 : 2 }}
        transition={{ type: "spring", stiffness: 500, damping: 30 }}
        className="absolute top-0.5 w-4 h-4 rounded-full"
        style={{ background: checked ? "oklch(0.09 0.02 255)" : "oklch(0.5 0.015 255)" }}
      />
    </button>
  </div>
);

export default function SettingsSection() {
  const [claudeKey, setClaudeKey] = useState("");
  const [gmailId, setGmailId] = useState("");
  const [gmailSecret, setGmailSecret] = useState("");
  const [yourName, setYourName] = useState("Christian Townhill");
  const [yourTitle, setYourTitle] = useState("Founder, InvestReach™");
  const [yourPhone, setYourPhone] = useState("");
  const [dailyLimit, setDailyLimit] = useState("40");
  const [cities, setCities] = useState("New York, NY\nLos Angeles, CA\nChicago, IL\nHouston, TX\nPhoenix, AZ\nPhiladelphia, PA\nSan Antonio, TX\nSan Diego, CA\nDallas, TX\nSan Jose, CA");
  const [keyword, setKeyword] = useState("independent financial advisor");
  const [scrapeTime, setScrapeTime] = useState("02:00");
  const [sendTime, setSendTime] = useState("08:00");
  const [reportTime, setReportTime] = useState("09:00");
  const [reportEmail, setReportEmail] = useState("");
  const [soundAlerts, setSoundAlerts] = useState(true);
  const [desktopNotifs, setDesktopNotifs] = useState(true);
  const [autoFollowUp, setAutoFollowUp] = useState(true);
  const [autoUnsubscribe, setAutoUnsubscribe] = useState(true);
  const [saved, setSaved] = useState(false);

  const handleSave = () => {
    setSaved(true);
    toast.success("Settings saved successfully", {
      description: "All configuration has been updated.",
    });
    setTimeout(() => setSaved(false), 3000);
  };

  return (
    <div className="p-6 max-w-4xl">
      <div className="mb-6">
        <h2 className="text-lg font-bold" style={{ color: "oklch(0.92 0.008 65)" }}>Settings</h2>
        <p className="text-sm mt-1" style={{ color: "oklch(0.55 0.015 255)" }}>Configure your API keys, Gmail connection, automation schedule, and preferences.</p>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
        {/* API Keys */}
        <SettingCard title="API Keys" icon={Key}>
          <Field label="Claude API Key" value={claudeKey} onChange={setClaudeKey} type="password"
            placeholder="sk-ant-api03-..." hint="Get your key at console.anthropic.com — ~$1 per 5,000 emails" />
          <div className="p-3 rounded-lg text-xs" style={{ background: "oklch(0.72 0.12 75 / 0.06)", border: "1px solid oklch(0.72 0.12 75 / 0.15)" }}>
            <p style={{ color: "oklch(0.72 0.12 75)" }}>💡 Recommended: Claude Haiku — fastest and cheapest model for email generation</p>
          </div>
        </SettingCard>

        {/* Gmail */}
        <SettingCard title="Gmail Connection" icon={Mail}>
          <Field label="OAuth Client ID" value={gmailId} onChange={setGmailId} type="password"
            placeholder="123456789-abc.apps.googleusercontent.com" />
          <Field label="OAuth Client Secret" value={gmailSecret} onChange={setGmailSecret} type="password"
            placeholder="GOCSPX-..." hint="Create at console.cloud.google.com → Gmail API → OAuth 2.0 Client" />
          <button className="w-full py-2 rounded-lg text-sm font-semibold transition-all"
            style={{ background: "oklch(0.72 0.12 75 / 0.12)", border: "1px solid oklch(0.72 0.12 75 / 0.3)", color: "oklch(0.72 0.12 75)" }}
            onClick={() => toast.info("Gmail OAuth flow would open here in the desktop app")}>
            🔗 Connect Gmail Account
          </button>
        </SettingCard>

        {/* Your Profile */}
        <SettingCard title="Your Profile" icon={Shield}>
          <Field label="Your Name" value={yourName} onChange={setYourName} />
          <Field label="Your Title" value={yourTitle} onChange={setYourTitle} />
          <Field label="Your Phone" value={yourPhone} onChange={setYourPhone} placeholder="(555) 000-0000" />
          <Field label="Report Email" value={reportEmail} onChange={setReportEmail} placeholder="you@email.com"
            hint="Daily briefing will be sent here every morning" />
        </SettingCard>

        {/* Scraper Config */}
        <SettingCard title="Scraper Configuration" icon={MapPin}>
          <Field label="Search Keyword" value={keyword} onChange={setKeyword}
            hint="e.g. 'independent financial advisor', 'RIA', 'wealth management firm'" />
          <div className="mb-4">
            <label className="block text-xs font-medium mb-1.5" style={{ color: "oklch(0.65 0.008 65)" }}>
              Target Cities (one per line)
            </label>
            <textarea
              value={cities}
              onChange={e => setCities(e.target.value)}
              rows={6}
              className="w-full rounded-lg px-3 py-2 text-xs outline-none resize-none"
              style={{
                background: "oklch(0.10 0.02 255)",
                border: "1px solid oklch(1 0 0 / 0.08)",
                color: "oklch(0.85 0.008 65)",
              }}
              onFocus={e => e.target.style.borderColor = "oklch(0.72 0.12 75 / 0.5)"}
              onBlur={e => e.target.style.borderColor = "oklch(1 0 0 / 0.08)"}
            />
            <p className="text-[10px] mt-1" style={{ color: "oklch(0.45 0.015 255)" }}>{cities.split("\n").filter(Boolean).length} cities configured</p>
          </div>
        </SettingCard>

        {/* Schedule */}
        <SettingCard title="Automation Schedule" icon={Clock}>
          <div className="grid grid-cols-3 gap-3 mb-4">
            {[
              { label: "Scrape Time", value: scrapeTime, onChange: setScrapeTime, hint: "Nightly scrape" },
              { label: "Send Time", value: sendTime, onChange: setSendTime, hint: "Morning emails" },
              { label: "Report Time", value: reportTime, onChange: setReportTime, hint: "Daily briefing" },
            ].map(f => (
              <div key={f.label}>
                <label className="block text-[10px] font-medium mb-1" style={{ color: "oklch(0.65 0.008 65)" }}>{f.label}</label>
                <input type="time" value={f.value} onChange={e => f.onChange(e.target.value)}
                  className="w-full rounded-lg px-2 py-1.5 text-xs outline-none"
                  style={{ background: "oklch(0.10 0.02 255)", border: "1px solid oklch(1 0 0 / 0.08)", color: "oklch(0.85 0.008 65)" }} />
                <p className="text-[9px] mt-0.5" style={{ color: "oklch(0.45 0.015 255)" }}>{f.hint}</p>
              </div>
            ))}
          </div>
          <Field label="Daily Email Send Limit" value={dailyLimit} onChange={setDailyLimit}
            hint="Recommended: 40–50/day for new Gmail accounts to avoid spam flags" />
        </SettingCard>

        {/* Notifications */}
        <SettingCard title="Notifications & Automation" icon={Bell}>
          <Toggle label="Sound Alerts" description="Play a sound when a hot lead replies"
            checked={soundAlerts} onChange={setSoundAlerts} />
          <Toggle label="Desktop Notifications" description="Show popup when a positive reply is detected"
            checked={desktopNotifs} onChange={setDesktopNotifs} />
          <Toggle label="Auto Follow-Up" description="Automatically send Day 3 and Day 7 follow-ups"
            checked={autoFollowUp} onChange={setAutoFollowUp} />
          <Toggle label="Auto Unsubscribe" description="Stop emailing anyone who replies 'unsubscribe'"
            checked={autoUnsubscribe} onChange={setAutoUnsubscribe} />
        </SettingCard>
      </div>

      {/* Save Button */}
      <motion.div className="mt-6 flex justify-end">
        <motion.button
          whileHover={{ scale: 1.02 }}
          whileTap={{ scale: 0.98 }}
          onClick={handleSave}
          className="flex items-center gap-2 px-6 py-2.5 rounded-lg text-sm font-semibold transition-all"
          style={{
            background: saved ? "oklch(0.65 0.18 145)" : "oklch(0.72 0.12 75)",
            color: "oklch(0.09 0.02 255)",
          }}
        >
          {saved ? <CheckCircle size={15} /> : <Save size={15} />}
          {saved ? "Saved!" : "Save All Settings"}
        </motion.button>
      </motion.div>
    </div>
  );
}
