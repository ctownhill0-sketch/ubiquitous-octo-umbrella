// LeadStack™ — Reply Monitor Section
import { motion, AnimatePresence } from "framer-motion";
import { useState, useEffect } from "react";
import { Phone, Star, Bell, BellOff, CheckCircle, MessageSquare, ThumbsUp, ThumbsDown, Minus, RefreshCw } from "lucide-react";
import { MOCK_REPLIES, Reply } from "@/lib/mockData";
import { toast } from "sonner";

const sentimentStyle = (s: string) => {
  if (s === "Positive") return { bg: "oklch(0.65 0.18 145 / 0.12)", color: "oklch(0.72 0.16 145)", border: "oklch(0.65 0.18 145 / 0.3)", icon: ThumbsUp };
  if (s === "Negative") return { bg: "oklch(0.65 0.22 25 / 0.12)", color: "oklch(0.75 0.20 25)", border: "oklch(0.65 0.22 25 / 0.3)", icon: ThumbsDown };
  return { bg: "oklch(0.55 0.015 255 / 0.12)", color: "oklch(0.65 0.015 255)", border: "oklch(0.55 0.015 255 / 0.3)", icon: Minus };
};

const categoryStyle = (c: string) => {
  if (c === "Interested") return "oklch(0.72 0.12 75)";
  if (c === "Not Interested") return "oklch(0.65 0.22 25)";
  if (c === "Referral") return "oklch(0.55 0.10 230)";
  if (c === "Question") return "oklch(0.65 0.18 145)";
  return "oklch(0.55 0.015 255)";
};

export default function ReplyMonitorSection() {
  const [replies, setReplies] = useState<Reply[]>(MOCK_REPLIES);
  const [soundEnabled, setSoundEnabled] = useState(true);
  const [filter, setFilter] = useState<string>("all");

  // Simulate incoming reply
  useEffect(() => {
    const t = setTimeout(() => {
      const newReply: Reply = {
        id: Date.now(),
        leadName: "Thomas Anderson",
        company: "Anderson Capital Management",
        email: "thomas@andersoncapital.com",
        subject: "Re: Quick question about your follow-up process",
        preview: "Hi, thanks for reaching out. I've actually been looking for something like this. Can we schedule a call this week?",
        sentiment: "Positive",
        category: "Interested",
        receivedAt: new Date().toLocaleTimeString(),
        isRead: false,
        read: false,
        isHot: false,
        step: 1,
      };
      setReplies(prev => [newReply, ...prev]);
      toast.success("🔥 New positive reply from Thomas Anderson!", {
        description: "Anderson Capital Management — marked as Interested",
        duration: 6000,
      });
    }, 12000);
    return () => clearTimeout(t);
  }, []);

  const filtered = filter === "all" ? replies : filter === "hot" ? replies.filter(r => r.isHot) : replies.filter(r => r.sentiment === filter);

  const markHot = (id: number) => {
    setReplies(prev => prev.map(r => r.id === id ? { ...r, isHot: true, category: "Interested" } : r));
    const r = replies.find(r => r.id === id);
    toast.success(`🔥 ${r?.leadName} marked as Hot Lead!`);
  };

  const stats = {
    total: replies.length,
    positive: replies.filter(r => r.sentiment === "Positive").length,
    negative: replies.filter(r => r.sentiment === "Negative").length,
    hot: replies.filter(r => r.isHot).length,
    unread: replies.filter(r => !r.isRead).length,
  };

  return (
    <div className="p-6 space-y-6">
      {/* Stats Row */}
      <div className="grid grid-cols-2 lg:grid-cols-5 gap-4">
        {[
          { label: "Total Replies", value: stats.total, color: "oklch(0.72 0.12 75)" },
          { label: "Positive", value: stats.positive, color: "oklch(0.65 0.18 145)" },
          { label: "Negative", value: stats.negative, color: "oklch(0.65 0.22 25)" },
          { label: "Hot Leads", value: stats.hot, color: "oklch(0.72 0.12 75)" },
          { label: "Unread", value: stats.unread, color: "oklch(0.55 0.10 230)" },
        ].map((s, i) => (
          <motion.div key={s.label}
            initial={{ opacity: 0, y: 16 }} animate={{ opacity: 1, y: 0 }}
            transition={{ delay: i * 0.07 }}
            className="rounded-lg p-4"
            style={{ background: "oklch(0.13 0.025 255)", border: "1px solid oklch(1 0 0 / 0.07)", borderTop: `2px solid ${s.color}` }}>
            <div className="stat-number text-2xl font-bold mb-1" style={{ color: "oklch(0.92 0.008 65)" }}>{s.value}</div>
            <div className="text-xs" style={{ color: "oklch(0.55 0.015 255)" }}>{s.label}</div>
          </motion.div>
        ))}
      </div>

      {/* Controls */}
      <div className="flex items-center gap-3 flex-wrap">
        <div className="flex gap-1 p-1 rounded-lg" style={{ background: "oklch(0.13 0.025 255)", border: "1px solid oklch(1 0 0 / 0.07)" }}>
          {[
            { key: "all", label: "All" },
            { key: "Positive", label: "Positive" },
            { key: "Negative", label: "Negative" },
            { key: "hot", label: "🔥 Hot" },
          ].map(f => (
            <button key={f.key} onClick={() => setFilter(f.key)}
              className="px-3 py-1.5 rounded text-xs font-medium transition-all"
              style={{
                background: filter === f.key ? "oklch(0.72 0.12 75)" : "transparent",
                color: filter === f.key ? "oklch(0.10 0.025 255)" : "oklch(0.55 0.015 255)",
              }}>
              {f.label}
            </button>
          ))}
        </div>

        <button onClick={() => setSoundEnabled(v => !v)}
          className="flex items-center gap-1.5 px-3 py-2 rounded text-xs font-medium transition-colors"
          style={{
            background: soundEnabled ? "oklch(0.65 0.18 145 / 0.12)" : "oklch(0.13 0.025 255)",
            color: soundEnabled ? "oklch(0.72 0.16 145)" : "oklch(0.55 0.015 255)",
            border: `1px solid ${soundEnabled ? "oklch(0.65 0.18 145 / 0.3)" : "oklch(1 0 0 / 0.07)"}`,
          }}>
          {soundEnabled ? <Bell size={12} /> : <BellOff size={12} />}
          Sound Alert {soundEnabled ? "On" : "Off"}
        </button>

        <button onClick={() => toast.info("Checking inbox...")}
          className="flex items-center gap-1.5 px-3 py-2 rounded text-xs font-medium transition-colors"
          style={{ background: "oklch(0.13 0.025 255)", color: "oklch(0.55 0.015 255)", border: "1px solid oklch(1 0 0 / 0.07)" }}>
          <RefreshCw size={12} /> Refresh
        </button>

        <span className="text-[10px] font-mono ml-auto" style={{ color: "oklch(0.55 0.015 255)" }}>
          {filtered.length} replies
        </span>
      </div>

      {/* Reply Feed */}
      <div className="space-y-3">
        <AnimatePresence mode="popLayout">
          {filtered.map((reply, i) => {
            const ss = sentimentStyle(reply.sentiment);
            const SentIcon = ss.icon;
            return (
              <motion.div key={reply.id}
                initial={{ opacity: 0, y: -10 }} animate={{ opacity: 1, y: 0 }}
                exit={{ opacity: 0, scale: 0.97 }}
                layout
                transition={{ delay: i * 0.03 }}
                className="rounded-lg p-4"
                style={{
                  background: reply.isHot ? "oklch(0.72 0.12 75 / 0.05)" : "oklch(0.13 0.025 255)",
                  border: `1px solid ${reply.isHot ? "oklch(0.72 0.12 75 / 0.25)" : "oklch(1 0 0 / 0.07)"}`,
                }}>
                <div className="flex items-start gap-3">
                  {/* Avatar */}
                  <div className="w-9 h-9 rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0"
                    style={{ background: "oklch(0.72 0.12 75 / 0.12)", color: "oklch(0.72 0.12 75)" }}>
                    {reply.leadName.split(" ").map(n => n[0]).join("").slice(0, 2)}
                  </div>

                  {/* Content */}
                  <div className="flex-1 min-w-0">
                    <div className="flex items-center gap-2 flex-wrap mb-1">
                      <span className="font-semibold text-sm" style={{ color: "oklch(0.92 0.008 65)" }}>{reply.leadName}</span>
                      {!reply.isRead && (
                        <span className="w-1.5 h-1.5 rounded-full flex-shrink-0" style={{ background: "oklch(0.55 0.10 230)" }} />
                      )}
                      {reply.isHot && (
                        <span className="text-[10px] px-1.5 py-0.5 rounded font-semibold badge-hot">🔥 Hot Lead</span>
                      )}
                      <span className="text-[10px] px-2 py-0.5 rounded font-medium flex items-center gap-1"
                        style={{ background: ss.bg, color: ss.color, border: `1px solid ${ss.border}` }}>
                        <SentIcon size={9} /> {reply.sentiment}
                      </span>
                      <span className="text-[10px] font-medium" style={{ color: categoryStyle(reply.category) }}>
                        {reply.category}
                      </span>
                    </div>

                    <div className="text-xs mb-1.5" style={{ color: "oklch(0.65 0.008 65)" }}>
                      {reply.company} · {reply.email}
                    </div>

                    <div className="text-xs font-medium mb-1" style={{ color: "oklch(0.80 0.008 65)" }}>
                      {reply.subject}
                    </div>

                    <div className="text-xs leading-relaxed" style={{ color: "oklch(0.65 0.008 65)" }}>
                      {reply.preview}
                    </div>

                    <div className="flex items-center gap-3 mt-3">
                      <span className="text-[10px]" style={{ color: "oklch(0.45 0.015 255)" }}>
                        Step {reply.step} · {typeof reply.receivedAt === "string" && reply.receivedAt.includes(":") ? reply.receivedAt : new Date(reply.receivedAt).toLocaleTimeString()}
                      </span>

                      <div className="flex items-center gap-2 ml-auto">
                        {!reply.isHot && reply.sentiment === "Positive" && (
                          <button onClick={() => markHot(reply.id)}
                            className="flex items-center gap-1.5 px-3 py-1.5 rounded text-xs font-semibold transition-all"
                            style={{ background: "oklch(0.72 0.12 75)", color: "oklch(0.10 0.025 255)" }}>
                            <Star size={11} /> Mark Hot Lead
                          </button>
                        )}
                        <button onClick={() => toast.success(`Calling ${reply.leadName}...`)}
                          className="flex items-center gap-1.5 px-3 py-1.5 rounded text-xs font-medium transition-colors"
                          style={{ background: "oklch(0.65 0.18 145 / 0.12)", color: "oklch(0.72 0.16 145)", border: "1px solid oklch(0.65 0.18 145 / 0.3)" }}>
                          <Phone size={11} /> Call Now
                        </button>
                        {reply.isHot && (
                          <span className="flex items-center gap-1 text-[10px]" style={{ color: "oklch(0.65 0.18 145)" }}>
                            <CheckCircle size={11} /> In Call List
                          </span>
                        )}
                      </div>
                    </div>
                  </div>
                </div>
              </motion.div>
            );
          })}
        </AnimatePresence>
      </div>
    </div>
  );
}
