// LeadStack™ — Main Dashboard Section
// Animated counters, live stats from Python backend, weekly trend charts
import { motion } from "framer-motion";
import { useEffect, useState } from "react";
import {
  AreaChart, Area, BarChart, Bar, XAxis, YAxis, Tooltip,
  ResponsiveContainer, CartesianGrid
} from "recharts";
import {
  Users, Mail, TrendingUp, Flame, DollarSign,
  ArrowUpRight, Phone, RefreshCw, AlertCircle
} from "lucide-react";
import { useApi } from "@/hooks/useApi";
import { getStats, getDailyReport } from "@/lib/api";
import { WEEKLY_LEADS_DATA, CITY_PERFORMANCE } from "@/lib/mockData";

function useCounter(target: number, duration = 1200) {
  const [value, setValue] = useState(0);
  useEffect(() => {
    let start = 0;
    const step = target / (duration / 16);
    const timer = setInterval(() => {
      start += step;
      if (start >= target) { setValue(target); clearInterval(timer); }
      else setValue(Math.floor(start));
    }, 16);
    return () => clearInterval(timer);
  }, [target, duration]);
  return value;
}

function StatCard({
  label, value, sub, icon: Icon, color, prefix = "", suffix = "", delay = 0, trend
}: {
  label: string; value: number; sub?: string; icon: React.ElementType;
  color: string; prefix?: string; suffix?: string; delay?: number;
  trend?: { value: number; positive: boolean };
}) {
  const count = useCounter(value, 1200 + delay);
  return (
    <motion.div
      initial={{ opacity: 0, y: 20 }}
      animate={{ opacity: 1, y: 0 }}
      transition={{ duration: 0.4, delay: delay / 1000 }}
      className="rounded-lg p-4 relative overflow-hidden"
      style={{
        background: "oklch(0.13 0.025 255)",
        border: "1px solid oklch(1 0 0 / 0.07)",
        borderTop: `2px solid ${color}`,
      }}
    >
      <div className="absolute top-0 right-0 w-20 h-20 rounded-full opacity-5 pointer-events-none"
        style={{ background: color, filter: "blur(20px)", transform: "translate(30%, -30%)" }} />
      <div className="flex items-start justify-between mb-3">
        <div className="w-8 h-8 rounded flex items-center justify-center"
          style={{ background: `${color}18` }}>
          <Icon size={15} style={{ color }} />
        </div>
        {trend && (
          <div className="flex items-center gap-1 text-[10px] font-mono"
            style={{ color: trend.positive ? "oklch(0.72 0.18 142)" : "oklch(0.65 0.2 25)" }}>
            <ArrowUpRight size={10} style={{ transform: trend.positive ? "none" : "rotate(90deg)" }} />
            {trend.value}%
          </div>
        )}
      </div>
      <div className="font-mono text-2xl font-bold mb-1" style={{ color: "oklch(0.95 0.01 65)" }}>
        {prefix}{count.toLocaleString()}{suffix}
      </div>
      <div className="text-[11px] font-medium" style={{ color: "oklch(0.55 0.015 255)" }}>{label}</div>
      {sub && <div className="text-[10px] mt-1" style={{ color: "oklch(0.45 0.015 255)" }}>{sub}</div>}
    </motion.div>
  );
}

const CustomTooltip = ({ active, payload, label }: any) => {
  if (!active || !payload?.length) return null;
  return (
    <div className="rounded-lg px-3 py-2 text-xs"
      style={{ background: "oklch(0.16 0.025 255)", border: "1px solid oklch(1 0 0 / 0.12)" }}>
      <p className="font-medium mb-1" style={{ color: "oklch(0.75 0.008 65)" }}>{label}</p>
      {payload.map((p: any) => (
        <p key={p.dataKey} className="font-mono" style={{ color: p.color }}>
          {p.name}: {p.value}
        </p>
      ))}
    </div>
  );
};

export default function DashboardSection() {
  const { data: stats, loading, error, refetch } = useApi(getStats, [], {
    pollInterval: 30000,
    fallback: {
      totalLeads: 0, leadsToday: 0, withEmail: 0, withPhone: 0,
      emailsSent: 0, emailsToday: 0, openRate: 0, replyRate: 0,
      hotLeads: 0, meetingsBooked: 0, pipelineValue: 0, projectedRevenue: 0,
    }
  });

  const { data: report } = useApi(getDailyReport, [], {
    fallback: { weeklyData: WEEKLY_LEADS_DATA, topCities: CITY_PERFORMANCE } as any
  });

  const weeklyData = (report as any)?.weeklyData ?? WEEKLY_LEADS_DATA;
  const cityData = (report as any)?.topCities ?? CITY_PERFORMANCE;

  return (
    <div className="p-6 space-y-6">
      {/* Header */}
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-xl font-bold" style={{ color: "oklch(0.92 0.008 65)" }}>
            Command Center
          </h1>
          <p className="text-xs mt-0.5" style={{ color: "oklch(0.45 0.015 255)" }}>
            Live metrics · auto-refreshes every 30s
          </p>
        </div>
        <div className="flex items-center gap-3">
          {error && (
            <div className="flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-lg"
              style={{ background: "oklch(0.65 0.2 25 / 0.12)", color: "oklch(0.75 0.15 25)", border: "1px solid oklch(0.65 0.2 25 / 0.2)" }}>
              <AlertCircle size={12} />
              Backend offline — showing cached data
            </div>
          )}
          <button onClick={refetch}
            className="flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-medium transition-all"
            style={{ background: "oklch(0.72 0.12 75 / 0.12)", color: "oklch(0.72 0.12 75)", border: "1px solid oklch(0.72 0.12 75 / 0.2)" }}>
            <RefreshCw size={12} className={loading ? "animate-spin" : ""} />
            Refresh
          </button>
        </div>
      </div>

      {/* Stat Cards */}
      <div className="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <StatCard label="Total Leads" value={stats?.totalLeads ?? 0}
          sub={`+${stats?.leadsToday ?? 0} today`}
          icon={Users} color="oklch(0.72 0.12 75)" delay={0}
          trend={{ value: 12, positive: true }} />
        <StatCard label="Emails Sent" value={stats?.emailsSent ?? 0}
          sub={`+${stats?.emailsToday ?? 0} today`}
          icon={Mail} color="oklch(0.65 0.18 255)" delay={80}
          trend={{ value: 8, positive: true }} />
        <StatCard label="Reply Rate" value={Math.round(stats?.replyRate ?? 0)}
          icon={TrendingUp} color="oklch(0.72 0.18 142)" suffix="%" delay={160}
          trend={{ value: 2, positive: true }} />
        <StatCard label="Hot Leads" value={stats?.hotLeads ?? 0}
          sub="Replied positively"
          icon={Flame} color="oklch(0.75 0.2 45)" delay={240}
          trend={{ value: 5, positive: true }} />
        <StatCard label="With Email" value={stats?.withEmail ?? 0}
          icon={Mail} color="oklch(0.62 0.15 200)" delay={320} />
        <StatCard label="With Phone" value={stats?.withPhone ?? 0}
          icon={Phone} color="oklch(0.65 0.15 280)" delay={400} />
        <StatCard label="Open Rate" value={Math.round(stats?.openRate ?? 0)}
          icon={TrendingUp} color="oklch(0.72 0.12 75)" suffix="%" delay={480} />
        <StatCard label="Pipeline Value" value={stats?.pipelineValue ?? 0}
          icon={DollarSign} color="oklch(0.72 0.12 75)" prefix="$" delay={560}
          trend={{ value: 18, positive: true }} />
      </div>

      {/* Charts */}
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <motion.div initial={{ opacity: 0, y: 16 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.3 }}
          className="lg:col-span-2 rounded-lg p-4"
          style={{ background: "oklch(0.13 0.025 255)", border: "1px solid oklch(1 0 0 / 0.07)" }}>
          <div className="flex items-center justify-between mb-4">
            <h3 className="text-sm font-semibold" style={{ color: "oklch(0.92 0.008 65)" }}>Weekly Activity</h3>
            <div className="flex items-center gap-3 text-[10px]">
              {[
                { color: "oklch(0.72 0.12 75)", label: "Leads" },
                { color: "oklch(0.65 0.18 255)", label: "Emails" },
                { color: "oklch(0.72 0.18 142)", label: "Replies" },
              ].map(l => (
                <div key={l.label} className="flex items-center gap-1">
                  <div className="w-2 h-2 rounded-full" style={{ background: l.color }} />
                  <span style={{ color: "oklch(0.55 0.015 255)" }}>{l.label}</span>
                </div>
              ))}
            </div>
          </div>
          <ResponsiveContainer width="100%" height={180}>
            <AreaChart data={weeklyData} margin={{ top: 0, right: 0, bottom: 0, left: -30 }}>
              <defs>
                <linearGradient id="gLeads" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="5%" stopColor="oklch(0.72 0.12 75)" stopOpacity={0.3} />
                  <stop offset="95%" stopColor="oklch(0.72 0.12 75)" stopOpacity={0} />
                </linearGradient>
                <linearGradient id="gEmails" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="5%" stopColor="oklch(0.65 0.18 255)" stopOpacity={0.3} />
                  <stop offset="95%" stopColor="oklch(0.65 0.18 255)" stopOpacity={0} />
                </linearGradient>
              </defs>
              <CartesianGrid strokeDasharray="3 3" stroke="oklch(1 0 0 / 0.05)" />
              <XAxis dataKey="day" tick={{ fontSize: 10, fill: "oklch(0.45 0.015 255)" }} axisLine={false} tickLine={false} />
              <YAxis tick={{ fontSize: 10, fill: "oklch(0.45 0.015 255)" }} axisLine={false} tickLine={false} />
              <Tooltip content={<CustomTooltip />} />
              <Area type="monotone" dataKey="leads" name="Leads" stroke="oklch(0.72 0.12 75)" fill="url(#gLeads)" strokeWidth={2} dot={false} />
              <Area type="monotone" dataKey="emails" name="Emails" stroke="oklch(0.65 0.18 255)" fill="url(#gEmails)" strokeWidth={2} dot={false} />
              <Area type="monotone" dataKey="replies" name="Replies" stroke="oklch(0.72 0.18 142)" fill="none" strokeWidth={2} dot={false} />
            </AreaChart>
          </ResponsiveContainer>
        </motion.div>

        <motion.div initial={{ opacity: 0, y: 16 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.4 }}
          className="rounded-lg p-4"
          style={{ background: "oklch(0.13 0.025 255)", border: "1px solid oklch(1 0 0 / 0.07)" }}>
          <h3 className="text-sm font-semibold mb-4" style={{ color: "oklch(0.92 0.008 65)" }}>Top Cities</h3>
          <div className="space-y-3">
            {cityData.slice(0, 5).map((city: any, i: number) => {
              const max = cityData[0]?.leads ?? 1;
              const pct = Math.round((city.leads / max) * 100);
              return (
                <div key={city.city}>
                  <div className="flex items-center justify-between mb-1">
                    <span className="text-[11px]" style={{ color: "oklch(0.75 0.008 65)" }}>{city.city.split(",")[0]}</span>
                    <span className="font-mono text-[11px] font-bold" style={{ color: "oklch(0.72 0.12 75)" }}>{city.leads}</span>
                  </div>
                  <div className="h-1 rounded-full" style={{ background: "oklch(1 0 0 / 0.06)" }}>
                    <motion.div initial={{ width: 0 }} animate={{ width: `${pct}%` }}
                      transition={{ duration: 0.8, delay: 0.5 + i * 0.1 }}
                      className="h-full rounded-full" style={{ background: "oklch(0.72 0.12 75)" }} />
                  </div>
                </div>
              );
            })}
          </div>
        </motion.div>
      </div>

      {/* Revenue projection */}
      <motion.div initial={{ opacity: 0, y: 16 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.5 }}
        className="rounded-lg p-4"
        style={{ background: "oklch(0.13 0.025 255)", border: "1px solid oklch(0.72 0.12 75 / 0.2)" }}>
        <div className="flex items-center justify-between">
          <div>
            <p className="text-[10px] font-medium mb-1" style={{ color: "oklch(0.55 0.015 255)" }}>PROJECTED MONTHLY REVENUE</p>
            <div className="flex items-baseline gap-2">
              <span className="font-mono text-3xl font-bold" style={{ color: "oklch(0.72 0.12 75)" }}>
                ${(stats?.projectedRevenue ?? 0).toLocaleString()}
              </span>
              <span className="text-xs" style={{ color: "oklch(0.55 0.015 255)" }}>
                from {stats?.meetingsBooked ?? 0} meetings booked
              </span>
            </div>
          </div>
          <div className="text-right">
            <p className="text-[10px] font-medium mb-1" style={{ color: "oklch(0.55 0.015 255)" }}>PIPELINE VALUE</p>
            <span className="font-mono text-xl font-bold" style={{ color: "oklch(0.92 0.008 65)" }}>
              ${(stats?.pipelineValue ?? 0).toLocaleString()}
            </span>
          </div>
        </div>
      </motion.div>
    </div>
  );
}
