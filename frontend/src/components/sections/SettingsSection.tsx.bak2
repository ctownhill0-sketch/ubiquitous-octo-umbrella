// LeadStack™ — Settings Section
// Configure API keys, email settings, automation parameters
import { motion } from "framer-motion";
import { useState, useEffect } from "react";
import { Save, Eye, EyeOff, RefreshCw, CheckCircle, AlertCircle, Key, Mail, Settings } from "lucide-react";
import { useApi } from "@/hooks/useApi";
import { getSettings, saveSettings, healthCheck, type Settings as SettingsType } from "@/lib/api";
import { toast } from "sonner";

export default function SettingsSection() {
  const [saving, setSaving] = useState(false);
  const [showAnthropicKey, setShowAnthropicKey] = useState(false);
  const [backendStatus, setBackendStatus] = useState<"checking" | "online" | "offline">("checking");

  const { data: settings, loading, refetch } = useApi(getSettings, [], {
    fallback: {
      anthropicKey: "",
      senderEmail: "",
      senderName: "",
      followUpDays: [3, 7, 14],
      maxEmailsPerDay: 50,
      scrapeDelay: 2,
      targetKeyword: "independent financial advisor",
      productName: "InvestReach",
      productUrl: "https://investreach.io",
    } as SettingsType
  });

  const [form, setForm] = useState<Partial<SettingsType>>({});

  useEffect(() => {
    if (settings) setForm(settings);
  }, [settings]);

  useEffect(() => {
    healthCheck()
      .then(() => setBackendStatus("online"))
      .catch(() => setBackendStatus("offline"));
  }, []);

  const handleSave = async () => {
    setSaving(true);
    try {
      await saveSettings(form);
      toast.success("Settings saved successfully.");
      refetch();
    } catch (e) {
      toast.error(`Failed to save: ${e instanceof Error ? e.message : "Backend offline?"}`);
    } finally {
      setSaving(false);
    }
  };

  const set = (key: keyof SettingsType, value: any) => {
    setForm(prev => ({ ...prev, [key]: value }));
  };

  return (
    <div className="p-6 space-y-6">
      {/* Header */}
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-xl font-bold" style={{ color: "oklch(0.92 0.008 65)" }}>Settings</h1>
          <p className="text-xs mt-0.5" style={{ color: "oklch(0.45 0.015 255)" }}>
            API keys, email config, automation parameters
          </p>
        </div>
        <div className="flex items-center gap-3">
          {/* Backend status */}
          <div className="flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-lg"
            style={{
              background: backendStatus === "online" ? "oklch(0.72 0.18 142 / 0.1)" : backendStatus === "offline" ? "oklch(0.65 0.2 25 / 0.1)" : "oklch(0.72 0.12 75 / 0.1)",
              color: backendStatus === "online" ? "oklch(0.72 0.18 142)" : backendStatus === "offline" ? "oklch(0.75 0.15 25)" : "oklch(0.72 0.12 75)",
              border: `1px solid ${backendStatus === "online" ? "oklch(0.72 0.18 142 / 0.2)" : backendStatus === "offline" ? "oklch(0.65 0.2 25 / 0.2)" : "oklch(0.72 0.12 75 / 0.2)"}`,
            }}>
            {backendStatus === "online" ? <CheckCircle size={11} /> : backendStatus === "offline" ? <AlertCircle size={11} /> : <RefreshCw size={11} className="animate-spin" />}
            Backend {backendStatus}
          </div>
          <button onClick={handleSave} disabled={saving}
            className="flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold disabled:opacity-50"
            style={{ background: "oklch(0.72 0.12 75)", color: "oklch(0.09 0.02 255)" }}>
            {saving ? <RefreshCw size={13} className="animate-spin" /> : <Save size={13} />}
            Save Settings
          </button>
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {/* API Keys */}
        <motion.div initial={{ opacity: 0, y: 16 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.1 }}
          className="rounded-lg p-5 space-y-4"
          style={{ background: "oklch(0.13 0.025 255)", border: "1px solid oklch(1 0 0 / 0.07)" }}>
          <div className="flex items-center gap-2 mb-1">
            <Key size={14} style={{ color: "oklch(0.72 0.12 75)" }} />
            <h3 className="text-sm font-semibold" style={{ color: "oklch(0.92 0.008 65)" }}>API Keys</h3>
          </div>

          <div>
            <label className="text-[10px] font-medium block mb-1.5" style={{ color: "oklch(0.55 0.015 255)" }}>
              ANTHROPIC API KEY (Claude AI)
            </label>
            <div className="relative">
              <input
                type={showAnthropicKey ? "text" : "password"}
                value={form.anthropicKey ?? ""}
                onChange={e => set("anthropicKey", e.target.value)}
                placeholder="sk-ant-…"
                className="w-full px-3 py-2 pr-9 rounded-lg text-xs outline-none font-mono"
                style={{ background: "oklch(0.10 0.02 255)", border: "1px solid oklch(1 0 0 / 0.1)", color: "oklch(0.85 0.008 65)" }}
              />
              <button onClick={() => setShowAnthropicKey(v => !v)}
                className="absolute right-2.5 top-1/2 -translate-y-1/2"
                style={{ color: "oklch(0.45 0.015 255)" }}>
                {showAnthropicKey ? <EyeOff size={13} /> : <Eye size={13} />}
              </button>
            </div>
            <p className="text-[10px] mt-1" style={{ color: "oklch(0.45 0.015 255)" }}>
              Get your key at <a href="https://console.anthropic.com" target="_blank" rel="noreferrer" style={{ color: "oklch(0.65 0.18 255)" }}>console.anthropic.com</a>
            </p>
          </div>

          <div className="pt-2" style={{ borderTop: "1px solid oklch(1 0 0 / 0.06)" }}>
            <p className="text-[10px] font-medium mb-2" style={{ color: "oklch(0.55 0.015 255)" }}>GMAIL OAUTH</p>
            <div className="p-3 rounded-lg text-xs"
              style={{ background: "oklch(0.10 0.02 255)", border: "1px solid oklch(1 0 0 / 0.06)" }}>
              <p style={{ color: "oklch(0.75 0.008 65)" }}>Gmail OAuth is configured via <code className="font-mono" style={{ color: "oklch(0.72 0.12 75)" }}>credentials.json</code> in the backend folder.</p>
              <p className="mt-1" style={{ color: "oklch(0.45 0.015 255)" }}>
                Place your Google Cloud OAuth credentials file at <code className="font-mono">backend/credentials.json</code> and run the backend once to authenticate.
              </p>
            </div>
          </div>
        </motion.div>

        {/* Email Settings */}
        <motion.div initial={{ opacity: 0, y: 16 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.2 }}
          className="rounded-lg p-5 space-y-4"
          style={{ background: "oklch(0.13 0.025 255)", border: "1px solid oklch(1 0 0 / 0.07)" }}>
          <div className="flex items-center gap-2 mb-1">
            <Mail size={14} style={{ color: "oklch(0.65 0.18 255)" }} />
            <h3 className="text-sm font-semibold" style={{ color: "oklch(0.92 0.008 65)" }}>Email Settings</h3>
          </div>

          <div className="grid grid-cols-2 gap-3">
            <div>
              <label className="text-[10px] font-medium block mb-1.5" style={{ color: "oklch(0.55 0.015 255)" }}>SENDER NAME</label>
              <input value={form.senderName ?? ""} onChange={e => set("senderName", e.target.value)}
                placeholder="Your Name"
                className="w-full px-3 py-2 rounded-lg text-xs outline-none"
                style={{ background: "oklch(0.10 0.02 255)", border: "1px solid oklch(1 0 0 / 0.1)", color: "oklch(0.85 0.008 65)" }} />
            </div>
            <div>
              <label className="text-[10px] font-medium block mb-1.5" style={{ color: "oklch(0.55 0.015 255)" }}>SENDER EMAIL</label>
              <input value={form.senderEmail ?? ""} onChange={e => set("senderEmail", e.target.value)}
                placeholder="you@gmail.com"
                className="w-full px-3 py-2 rounded-lg text-xs outline-none"
                style={{ background: "oklch(0.10 0.02 255)", border: "1px solid oklch(1 0 0 / 0.1)", color: "oklch(0.85 0.008 65)" }} />
            </div>
          </div>

          <div>
            <label className="text-[10px] font-medium block mb-1.5" style={{ color: "oklch(0.55 0.015 255)" }}>
              MAX EMAILS PER DAY: <span style={{ color: "oklch(0.72 0.12 75)" }}>{form.maxEmailsPerDay ?? 50}</span>
            </label>
            <input type="range" min={10} max={200} step={10} value={form.maxEmailsPerDay ?? 50}
              onChange={e => set("maxEmailsPerDay", Number(e.target.value))}
              className="w-full accent-amber-400" />
            <div className="flex justify-between text-[9px] mt-1" style={{ color: "oklch(0.45 0.015 255)" }}>
              <span>10</span><span>200</span>
            </div>
          </div>

          <div>
            <label className="text-[10px] font-medium block mb-1.5" style={{ color: "oklch(0.55 0.015 255)" }}>FOLLOW-UP SCHEDULE (days)</label>
            <div className="flex items-center gap-2">
              {(form.followUpDays ?? [3, 7, 14]).map((day, i) => (
                <div key={i} className="flex items-center gap-1">
                  <span className="text-[10px]" style={{ color: "oklch(0.45 0.015 255)" }}>Email {i + 2}:</span>
                  <input type="number" value={day} min={1} max={30}
                    onChange={e => {
                      const days = [...(form.followUpDays ?? [3, 7, 14])];
                      days[i] = Number(e.target.value);
                      set("followUpDays", days);
                    }}
                    className="w-12 px-2 py-1 rounded text-xs text-center outline-none font-mono"
                    style={{ background: "oklch(0.10 0.02 255)", border: "1px solid oklch(1 0 0 / 0.1)", color: "oklch(0.85 0.008 65)" }} />
                  <span className="text-[10px]" style={{ color: "oklch(0.45 0.015 255)" }}>d</span>
                </div>
              ))}
            </div>
          </div>
        </motion.div>

        {/* Scraper Settings */}
        <motion.div initial={{ opacity: 0, y: 16 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.3 }}
          className="rounded-lg p-5 space-y-4"
          style={{ background: "oklch(0.13 0.025 255)", border: "1px solid oklch(1 0 0 / 0.07)" }}>
          <div className="flex items-center gap-2 mb-1">
            <Settings size={14} style={{ color: "oklch(0.72 0.18 142)" }} />
            <h3 className="text-sm font-semibold" style={{ color: "oklch(0.92 0.008 65)" }}>Scraper Settings</h3>
          </div>

          <div>
            <label className="text-[10px] font-medium block mb-1.5" style={{ color: "oklch(0.55 0.015 255)" }}>DEFAULT KEYWORD</label>
            <input value={form.targetKeyword ?? ""} onChange={e => set("targetKeyword", e.target.value)}
              placeholder="independent financial advisor"
              className="w-full px-3 py-2 rounded-lg text-xs outline-none"
              style={{ background: "oklch(0.10 0.02 255)", border: "1px solid oklch(1 0 0 / 0.1)", color: "oklch(0.85 0.008 65)" }} />
          </div>

          <div>
            <label className="text-[10px] font-medium block mb-1.5" style={{ color: "oklch(0.55 0.015 255)" }}>
              SCRAPE DELAY (seconds): <span style={{ color: "oklch(0.72 0.12 75)" }}>{form.scrapeDelay ?? 2}s</span>
            </label>
            <input type="range" min={1} max={10} step={0.5} value={form.scrapeDelay ?? 2}
              onChange={e => set("scrapeDelay", Number(e.target.value))}
              className="w-full accent-amber-400" />
            <p className="text-[10px] mt-1" style={{ color: "oklch(0.45 0.015 255)" }}>
              Delay between requests to avoid rate limiting. Recommended: 2–4s.
            </p>
          </div>
        </motion.div>

        {/* Product Settings */}
        <motion.div initial={{ opacity: 0, y: 16 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.4 }}
          className="rounded-lg p-5 space-y-4"
          style={{ background: "oklch(0.13 0.025 255)", border: "1px solid oklch(1 0 0 / 0.07)" }}>
          <h3 className="text-sm font-semibold" style={{ color: "oklch(0.92 0.008 65)" }}>Product Info</h3>
          <p className="text-[10px]" style={{ color: "oklch(0.45 0.015 255)" }}>
            Used by Claude AI when writing personalized emails.
          </p>

          <div>
            <label className="text-[10px] font-medium block mb-1.5" style={{ color: "oklch(0.55 0.015 255)" }}>PRODUCT NAME</label>
            <input value={form.productName ?? ""} onChange={e => set("productName", e.target.value)}
              placeholder="InvestReach"
              className="w-full px-3 py-2 rounded-lg text-xs outline-none"
              style={{ background: "oklch(0.10 0.02 255)", border: "1px solid oklch(1 0 0 / 0.1)", color: "oklch(0.85 0.008 65)" }} />
          </div>

          <div>
            <label className="text-[10px] font-medium block mb-1.5" style={{ color: "oklch(0.55 0.015 255)" }}>PRODUCT URL</label>
            <input value={form.productUrl ?? ""} onChange={e => set("productUrl", e.target.value)}
              placeholder="https://investreach.io"
              className="w-full px-3 py-2 rounded-lg text-xs outline-none"
              style={{ background: "oklch(0.10 0.02 255)", border: "1px solid oklch(1 0 0 / 0.1)", color: "oklch(0.85 0.008 65)" }} />
          </div>
        </motion.div>
      </div>
    </div>
  );
}
