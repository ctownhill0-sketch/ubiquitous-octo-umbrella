# LeadStack — frontend environment variables
#
# Copy this file to .env.local and adjust as needed:
#   cp .env.example .env.local
#
# VITE_API_URL is read at build time. Leave unset for `npm run dev` against
# a Flask backend running on localhost:7432; set it for production deploys
# pointing at your hosted backend.
#
# Examples:
#   VITE_API_URL=http://localhost:7432              # local dev (default)
#   VITE_API_URL=https://api.leadstack.example.com  # production
VITE_API_URL=http://localhost:7432
